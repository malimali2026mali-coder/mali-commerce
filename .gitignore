:root {
  font-family: 'Inter', sans-serif;
  color: #1d1d1f;
  background: #f6f7fb;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: linear-gradient(180deg, #fff5ef 0%, #f5f7fb 30%, #f9fafc 100%);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

#root {
  min-height: 100vh;
}

.container {
  width: min(1200px, calc(100% - 40px));
  margin: 0 auto;
}

.app-shell {
  min-height: 100vh;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(15, 23, 42, 0.04);
}

.topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 0;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-logo {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9a2f 100%);
  color: #fff;
  font-weight: 800;
  font-size: 1.2rem;
  box-shadow: 0 10px 20px rgba(255, 122, 0, 0.25);
}

.brand-name {
  font-size: 1.1rem;
  font-weight: 800;
  color: #111827;
}

.brand-subtitle {
  color: #6b7280;
  font-size: 0.72rem;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 22px;
  color: #374151;
  font-weight: 500;
}

.main-nav a {
  transition: color 0.2s ease;
}

.main-nav a:hover {
  color: #ff7a00;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ghost-btn,
.primary-btn,
.filter-chip,
.product-btn,
.hero-search button {
  border: none;
  border-radius: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.ghost-btn,
.filter-chip {
  background: #f3f4f6;
  color: #111827;
  padding: 10px 16px;
  font-weight: 600;
}

.primary-btn,
.hero-search button,
.product-btn {
  background: linear-gradient(135deg, #ff7a00 0%, #ff9a2f 100%);
  color: #fff;
  box-shadow: 0 12px 24px rgba(255, 122, 0, 0.2);
}

.primary-btn {
  padding: 12px 18px;
  font-weight: 700;
}

.hero-search button,
.product-btn {
  padding: 12px 18px;
  font-weight: 700;
}

.ghost-btn:hover,
.primary-btn:hover,
.filter-chip:hover,
.product-btn:hover,
.hero-search button:hover {
  transform: translateY(-1px);
}

.promo-strip {
  background: #1f2937;
  color: #f9fafb;
}

.promo-content {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18px;
  font-size: 0.84rem;
  padding: 10px 0;
  font-weight: 600;
}

.page-content {
  padding: 32px 0 48px;
}

.hero {
  display: grid;
  grid-template-columns: 1.2fr 0.9fr;
  gap: 32px;
  align-items: center;
  padding: 24px 0 18px;
}

.eyebrow {
  display: inline-block;
  padding: 7px 12px;
  border-radius: 999px;
  background: #fff1e2;
  color: #c56100;
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.hero-copy h1 {
  margin: 18px 0 12px;
  font-size: clamp(2.5rem, 4vw, 4.1rem);
  line-height: 1.05;
  letter-spacing: -0.06em;
  color: #111827;
}

.hero-copy p {
  margin: 0;
  color: #4b5563;
  font-size: 1.05rem;
  max-width: 560px;
}

.hero-search {
  margin-top: 24px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff;
  border-radius: 18px;
  padding: 10px 10px 10px 16px;
  border: 1px solid #e5e7eb;
  box-shadow: 0 10px 24px rgba(17, 24, 39, 0.04);
  max-width: 620px;
}

.hero-search input {
  flex: 1;
  border: none;
  background: transparent;
  outline: none;
  font-size: 1rem;
  padding: 10px 0;
}

.hero-stats {
  display: flex;
  gap: 28px;
  margin-top: 28px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hero-stats strong {
  font-size: 1.3rem;
  color: #111827;
}

.hero-stats span {
  color: #6b7280;
  font-size: 0.82rem;
}

.hero-visual {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-preview {
  width: min(92%, 430px);
  border-radius: 32px;
  background: linear-gradient(120deg, rgba(255, 122, 0, 0.08), rgba(0, 0, 0, 0.04));
  padding: 18px;
  box-shadow: 0 30px 60px rgba(15, 23, 42, 0.11);
}

.product-preview img {
  width: 100%;
  height: 480px;
  object-fit: cover;
  border-radius: 24px;
}

.mini-card {
  position: absolute;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(17, 24, 39, 0.06);
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  border-radius: 16px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.mini-card span {
  color: #6b7280;
  font-size: 0.72rem;
}

.mini-card strong {
  color: #111827;
  font-size: 0.95rem;
}

.card-top {
  top: 18px;
  left: 0;
}

.card-bottom {
  right: 18px;
  bottom: 30px;
}

.deals-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin: 18px 0 36px;
}

.deal-card {
  background: #fff;
  border-radius: 20px;
  padding: 24px 20px;
  border: 1px solid rgba(17, 24, 39, 0.04);
  box-shadow: 0 12px 30px rgba(17, 24, 39, 0.04);
}

.deal-card span {
  display: block;
  color: #6b7280;
  font-size: 0.8rem;
  margin-bottom: 12px;
}

.deal-card strong {
  color: #111827;
  font-size: 1.1rem;
}

.catalogue {
  margin-top: 18px;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 20px;
}

.section-head h2 {
  margin: 10px 0 0;
  font-size: clamp(1.8rem, 2vw, 2.5rem);
  letter-spacing: -0.05em;
  color: #111827;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: flex-end;
}

.filter-chip {
  padding: 10px 14px;
  font-size: 0.88rem;
  font-weight: 600;
}

.filter-chip.active {
  background: #111827;
  color: #fff;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
}

.product-card {
  background: #fff;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(17, 24, 39, 0.04);
  box-shadow: 0 12px 30px rgba(17, 24, 39, 0.04);
}

.product-image-wrap {
  position: relative;
  background: #f9fafb;
  height: 220px;
}

.product-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-tag {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(255, 122, 0, 0.95);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 6px 10px;
  border-radius: 999px;
}

.product-info {
  padding: 18px 16px 20px;
}

.product-seller {
  color: #6b7280;
  font-size: 0.78rem;
  margin-bottom: 10px;
}

.product-info h3 {
  margin: 0;
  min-height: 48px;
  font-size: 1.04rem;
  line-height: 1.4;
  color: #111827;
}

.rating-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  color: #f59e0b;
  font-weight: 700;
}

.rating-row small {
  color: #6b7280;
  font-weight: 500;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 14px;
}

.price-row strong {
  color: #111827;
  font-size: 1.3rem;
}

.price-row span {
  color: #9ca3af;
  text-decoration: line-through;
  font-size: 0.9rem;
}

.shipping-row {
  margin-top: 10px;
  color: #16a34a;
  font-size: 0.8rem;
  font-weight: 600;
}

.product-btn {
  width: 100%;
  margin-top: 18px;
  border: none;
}

.features-panel {
  margin-top: 52px;
  background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
  border-radius: 28px;
  padding: 32px 28px;
  color: #fff;
}

.feature-copy h2 {
  margin: 12px 0 0;
  font-size: clamp(1.9rem, 2vw, 3rem);
  letter-spacing: -0.05em;
}

.feature-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 26px;
}

.feature-list div {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;
  padding: 22px 18px;
}

.feature-list strong {
  display: block;
  margin-bottom: 10px;
  font-size: 1.05rem;
}

.feature-list p {
  margin: 0;
  color: rgba(255, 255, 255, 0.75);
}

.mobile-banner {
  margin-top: 46px;
  background: linear-gradient(135deg, #fff1e2 0%, #ffe7cd 100%);
  border-radius: 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 28px 32px;
}

.mobile-banner h2 {
  margin: 10px 0 0;
  font-size: clamp(1.8rem, 2vw, 2.5rem);
  letter-spacing: -0.05em;
  color: #111827;
}

.site-footer {
  background: #0b1220;
  color: #dbe3ef;
  margin-top: 42px;
  padding: 34px 0 40px;
}

.footer-inner {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 28px;
}

.footer-logo {
  margin-bottom: 14px;
}

.site-footer p,
.site-footer li {
  color: rgba(219, 227, 239, 0.76);
}

.site-footer h4 {
  margin: 0 0 14px;
  color: #fff;
}

.site-footer ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
}

@media (max-width: 1060px) {
  .products-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .hero-visual {
    min-height: 420px;
  }
}

@media (max-width: 760px) {
  .main-nav,
  .nav-actions {
    display: none;
  }

  .deals-grid,
  .feature-list,
  .products-grid,
  .footer-inner {
    grid-template-columns: 1fr;
  }

  .promo-content {
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-head,
  .mobile-banner {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-search {
    flex-direction: column;
    align-items: stretch;
    padding: 12px;
  }

  .hero-search input {
    width: 100%;
  }

  .hero-search button {
    width: 100%;
  }

  .hero-stats {
    flex-wrap: wrap;
    gap: 18px;
  }
}
